<?xml version="1.0"?>
<ruleset name="AdminKit Security &amp; Compatibility">
	<description>Focused WPCS Security, i18n and PHP 7.4-8.4 compatibility gate for AdminKit.</description>

	<file>adminkit.php</file>
	<file>uninstall.php</file>
	<file>inc</file>

	<exclude-pattern>inc/generated/lucide-paths\.php$</exclude-pattern>
	<exclude-pattern>dev/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-8.4"/>
	<config name="minimum_wp_version" value="6.0"/>

	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress.Security.EscapeOutput"/>
	<rule ref="WordPress.Security.ValidatedSanitizedInput"/>
	<rule ref="WordPress.Security.NonceVerification"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="adminkit"/>
			</property>
		</properties>
	</rule>
</ruleset>
