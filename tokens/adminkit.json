{
  "--ak-bg": "var(--wk-bg)",
  "--ak-surface": "var(--wk-surface)",
  "--ak-elevated": "var(--wk-surface-raised)",
  "--ak-input-bg": "var(--wk-surface)",
  "--ak-surface-muted": "var(--wk-surface-sunken)",
  "--ak-border": "var(--wk-border)",
  "--ak-border-strong": "var(--wk-border-strong)",
  "--ak-text": "var(--wk-text)",
  "--ak-text-muted": "var(--wk-text-muted)",
  "--ak-heading": "var(--wk-text)",
  "--ak-primary": "var(--wk-accent)",
  "--ak-primary-hover": "var(--wk-accent-hover)",
  "--ak-primary-subtle": "var(--wk-accent-soft)",
  "--ak-on-accent": "var(--wk-on-accent)",
  "--ak-secondary": "var(--ak-primary)",
  "--ak-hover-bg": "var(--wk-surface-hover)",
  "--ak-shadow-elevated": "var(--wk-elevation-2)",
  "--ak-focus": "var(--wk-focus-ring)",
  "--ak-focus-ring": "0 0 0 var(--wk-focus-offset) var(--ak-bg),\n\t\t0 0 0 calc(var(--wk-focus-offset) + var(--wk-focus-width)) var(--ak-focus)",
  "--ak-overlay": "var(--wk-overlay)",
  "--ak-success": "var(--wk-success-text)",
  "--ak-success-subtle": "var(--wk-success-soft)",
  "--ak-warning": "var(--wk-warning-text)",
  "--ak-warning-subtle": "var(--wk-warning-soft)",
  "--ak-error": "var(--wk-danger-text)",
  "--ak-error-subtle": "var(--wk-danger-soft)",
  "--ak-info": "var(--wk-info-text)",
  "--ak-info-subtle": "var(--wk-info-soft)",
  "--ak-radius-s": "var(--wk-radius-md)",
  "--ak-radius-m": "var(--wk-radius-lg)",
  "--ak-radius-l": "var(--wk-radius-xl)",
  "--ak-radius-xl": "var(--wk-radius-2xl)",
  "--ak-radius-full": "var(--wk-radius-full)",
  "--ak-font-body": "var(--wk-font-sans)",
  "--ak-font-mono": "var(--wk-font-mono)",
  "--ak-btn-bg": "var(--wk-surface)",
  "--ak-btn-hover-bg": "var(--wk-surface-hover)",
  "--ak-btn-hover-border": "var(--wk-border-strong)",
  "--ak-space-2xs": "2px",
  "--ak-space-xs": "4px",
  "--ak-space-s": "8px",
  "--ak-space-m": "12px",
  "--ak-space-l": "16px",
  "--ak-text-xs": "12px",
  "--ak-text-s": "13px",
  "--ak-text-m": "14px",
  "--ak-shadow-subtle": "var(--wk-elevation-1)",
  "--ak-btn-primary-shadow": "var(--ak-shadow-subtle), inset 0 1px 0 oklch(100% 0 0 / 0.14)",
  "--ak-duration-fast": "var(--wk-duration-fast)",
  "--ak-ease-standard": "var(--wk-ease-standard)",
  "--ak-primary-text": "var(--wk-accent-text)",
  "--ak-layout-wide": "var(--wk-layout-wide)",
  "--ak-on-accent-hover": "var(--ak-on-accent)",
  "--ak-control-height": "32px",
  "--ak-control-height-touch": "44px",
  "--ak-muted": "var(--ak-text-muted)",
  "--ak-text-subtle": "var(--wk-text-subtle)",
  "--ak-text-disabled": "var(--wk-text-disabled)",
  "--ak-input-border": "var(--ak-border)",
  "--ak-icon": "color-mix(in srgb, var(--ak-text-muted) 68%, var(--ak-surface))",
  "--ak-icon-active": "var(--ak-text-muted)"
}
