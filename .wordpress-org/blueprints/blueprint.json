{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "AdminKit — live demo",
		"description": "Try AdminKit on a throwaway WordPress, installed straight from the main branch.",
		"author": "waaskit",
		"categories": ["Plugins"]
	},
	"landingPage": "/wp-admin/admin.php?page=adminkit",
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/vuckro/adminkit",
				"ref": "main",
				"refType": "branch"
			},
			"options": {
				"activate": true
			}
		}
	]
}
