{
  "rules": {
    "color-no-invalid-hex": true,
    "block-no-empty": true,
    "declaration-block-no-duplicate-custom-properties": true,
    "no-invalid-double-slash-comments": true,
    "color-no-hex": true,
    "property-disallowed-list": [
      "margin-left",
      "margin-right",
      "padding-left",
      "padding-right"
    ]
  },
  "overrides": [
    {
      "files": [
        "../../inc/integrations/**/*.css",
        "**/integrations/**/*.css"
      ],
      "rules": {
        "property-disallowed-list": null
      }
    },
    {
      "files": [
        "**/waaskit-tokens.css",
        "**/waaskit-toolbar-tokens.css",
        "**/tokens.css",
        "**/settings.css",
        "**/settings/*.css",
        "**/login.css",
        "**/about.css",
        "**/code-mirror.css"
      ],
      "rules": {
        "color-no-hex": null
      }
    }
  ]
}
